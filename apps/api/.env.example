# Copie ce fichier vers .env puis renseigne la clé.
# .env est ignoré par git : il ne doit jamais être commité.

# Fournisseur LLM. Valeurs possibles : anthropic
LLM_PROVIDER=anthropic

# Clé API du fournisseur (ne vit QUE côté serveur, jamais exposée au front)
LLM_API_KEY=

# Identifiant du modèle utilisé
LLM_MODEL=claude-opus-5-5

# --- RAG ---------------------------------------------------------------
# Base Postgres + pgvector (voir docker-compose.yml à la racine du monorepo)
DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# Fournisseur d'embeddings. Valeurs possibles : voyage
EMBEDDING_PROVIDER=voyage
# Clé API Voyage AI (https://dashboard.voyageai.com)
EMBEDDING_API_KEY=
# Modèle d'embeddings
EMBEDDING_MODEL=voyage-3.5
# Dimension des vecteurs. Fixée dans la colonne SQL à la migration :
# la changer impose de recréer la table et de tout réingérer.
EMBEDDING_DIMENSION=1024

# Recherche utilisée par /chat et par les scripts : vector, lexical ou hybrid.
# Optionnelle (vector si absente). Voir docs/cours/jour-3-hybride.md.
RAG_SEARCH_MODE=vector

# --- Évaluation -----------------------------------------------------------
# Modèle juge de l'exactitude (npm run eval) : un autre modèle que LLM_MODEL,
# qui accepte temperature 0. Optionnel (claude-haiku-4-5 si absent).
EVAL_JUDGE_MODEL=claude-haiku-4-5
