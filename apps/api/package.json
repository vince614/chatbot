{
  "name": "@chatbot/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "hello": "tsx --conditions=development src/hello.ts",
    "typecheck": "tsc -b ../../packages/rag && tsc --noEmit",
    "build": "tsc -b",
    "db:migrate": "tsx --conditions=development src/rag/scripts/migrate.ts",
    "rag:preview": "tsx --conditions=development src/rag/scripts/preview.ts",
    "rag:embed-check": "tsx --conditions=development src/rag/scripts/embed-check.ts",
    "ingest": "tsx --conditions=development src/rag/scripts/ingest.ts",
    "search": "tsx --conditions=development src/rag/scripts/search.ts",
    "rag:sample-pdf": "tsx --conditions=development src/rag/scripts/make-sample-pdf.ts",
    "ask": "tsx --conditions=development src/rag/scripts/ask.ts",
    "mcp:probe": "tsx --conditions=development src/mcp/probe.ts",
    "eval:run": "tsx --conditions=development src/evals/run.ts",
    "eval:score": "tsx --conditions=development src/evals/score.ts",
    "eval:compare": "tsx --conditions=development src/evals/compare.ts",
    "eval:grade": "tsx --conditions=development src/evals/grade.ts",
    "eval:calibrate": "tsx --conditions=development src/evals/calibrate.ts",
