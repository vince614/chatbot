    "eval:history": "tsx --conditions=development src/evals/history.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@chatbot/rag": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.0"
  }
}
