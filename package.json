{
  "name": "chatbot",
  "private": true,
  "version": "0.1.0",
  "description": "Mini-projet d'apprentissage : chatbot React + Node (Fastify)",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "typecheck": "npm run typecheck --workspaces",
    "hello": "npm run hello -w apps/api",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run db:migrate -w apps/api",
    "rag:preview": "npm run rag:preview -w apps/api --",
    "rag:embed-check": "npm run rag:embed-check -w apps/api",
    "ingest": "npm run ingest -w apps/api",
    "search": "npm run search -w apps/api --",
    "rag:sample-pdf": "npm run rag:sample-pdf -w apps/api",
    "ask": "npm run ask -w apps/api --",
    "eval:run": "npm run eval:run -w apps/api --",
    "eval:score": "npm run eval:score -w apps/api --",
    "eval:compare": "npm run eval:compare -w apps/api --",
    "eval:grade": "npm run eval:grade -w apps/api --",
    "eval:calibrate": "npm run eval:calibrate -w apps/api --",
    "eval": "npm run eval -w apps/api --",
    "eval:history": "npm run eval:history -w apps/api --",
    "mcp": "npm run --silent mcp -w apps/mcp-server",
    "mcp:probe": "npm run mcp:probe -w apps/api --"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  }
}
